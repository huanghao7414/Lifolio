SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Optional server fallback. Leave blank to require each user's own AI configuration.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Set a long random, stable secret in production. Blank uses SUPABASE_JWT_SECRET.
# Rotating this value invalidates existing encrypted user API keys.
LLM_KEY_ENCRYPTION_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Comma-separated Supabase auth user UUIDs; empty means no administrator access.
ADMIN_USER_IDS=
# Enable only after configuring the corresponding Supabase Auth provider.
AUTH_PHONE_ENABLED=false
AUTH_GOOGLE_ENABLED=false
# Reserved WeChat broker: configure a standards-compliant provider in Supabase first.
# Example: custom:wechat (not a WeChat AppID or secret).
AUTH_WECHAT_PROVIDER=
