{
  "expo": {
    "name": "Lifolio",
    "slug": "lifolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lifolio",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lifolio.app",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄小票和物品照片",
        "NSMicrophoneUsageDescription": "用于语音输入记账",
        "NSSpeechRecognitionUsageDescription": "用于语音识别"
      }
    },
    "android": {
      "package": "com.lifolio.app",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
